{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccagentorg.github.io/card-block-api/schemas/bank.schema.json",
  "title": "Card Block API \u2014 Bank",
  "description": "Verified payment-instrument blocking information for one bank. Pilot: India. See AGENTS.md for conventions.",
  "type": "object",
  "required": [
    "name",
    "slug",
    "type",
    "cards",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "public",
        "private",
        "rrb",
        "coop",
        "payments",
        "sfb",
        "foreign"
      ]
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "type",
        "blocking_methods"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "debit",
            "credit",
            "prepaid",
            "forex"
          ]
        },
        "blocking_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/method"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "channel",
        "instructions",
        "confidence",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "sms",
            "phone",
            "app",
            "website",
            "email",
            "branch",
            "upi",
            "network",
            "govt"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "instructions": {
          "type": "string",
          "minLength": 10
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "confirmations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "worked": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "last_confirmation": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "last_verified",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "human_verified",
            "agent_verified",
            "unverified",
            "disputed"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        }
      }
    }
  }
}
