{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccagentorg.github.io/card-block-api/schemas/index.schema.json",
  "title": "Card Block API \u2014 Bank Index",
  "type": "object",
  "required": [
    "schema_version",
    "updated",
    "count",
    "banks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "banks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "type",
          "card_types",
          "method_count",
          "verification_status",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "public",
              "private",
              "rrb",
              "coop",
              "payments",
              "sfb",
              "foreign"
            ]
          },
          "card_types": {
            "type": "array",
            "items": {
              "enum": [
                "debit",
                "credit",
                "prepaid",
                "forex"
              ]
            },
            "minItems": 1
          },
          "method_count": {
            "type": "integer",
            "minimum": 1
          },
          "verification_status": {
            "enum": [
              "human_verified",
              "agent_verified",
              "unverified",
              "disputed"
            ]
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
